<header class="topbar" id="home-topbar">
  <div class="topbar-inner">
    <a href="#top" class="topbar-brand">
      <span class="led"></span>
      jidonglab
    </a>
    <nav class="topbar-nav">
      <a href="#do" data-ko="하는 일" data-en="What I build">하는 일</a>
      <a href="#how" data-ko="방식" data-en="How">방식</a>
      <a href="#projects" data-ko="작업" data-en="Work">작업</a>
      <a href="#logs" data-ko="로그" data-en="Logs">로그</a>
    </nav>
    <a
      href="#contact"
      class="topbar-cta"
      data-ko="의뢰 →"
      data-en="hire me →"
    >의뢰 →</a>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.getElementById('home-topbar');
    if (!nav) return;
    function onScroll() {
      if (window.scrollY > 40) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
