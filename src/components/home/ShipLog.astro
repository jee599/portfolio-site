---
import { getCollection } from 'astro:content';

const logs = (await getCollection('build-logs'))
  .filter((p) => p.data.lang === 'ko')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 7);

const fmtDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${dd}`;
};
---
<section id="logs" class="sec">
  <div class="sec-head">
    <div class="lead">
      <div class="sec-kicker">
        <span class="n">02</span>
        <span class="sep">/</span>
        <span>build logs</span>
      </div>
      <h2 class="sec-h" data-ko="ko/en 쌍으로 쌓이는 로그" data-en="Logs in ko/en pairs">
        ko/en 쌍으로 쌓이는 로그
      </h2>
      <p class="sec-desc" data-ko="커밋 diff에서 한국어와 영어 로그가 같이 정리된다. 잘된 결정보다 막힌 기록이 더 많다." data-en="Each commit diff becomes a paired Korean/English log. More dead ends than wins.">
        커밋 diff에서 한국어와 영어 로그가 같이 정리된다. 잘된 결정보다 막힌 기록이 더 많다.
      </p>
    </div>
    <a class="sec-link" href="/posts" data-ko="전체 빌드 로그 →" data-en="all logs →">전체 빌드 로그 →</a>
  </div>

  <div class="logs-wrap">
    {logs.map((log) => {
      const type = log.data.tags?.[0] ?? 'build';
      return (
        <a class="log" href={`/posts/${log.slug}`}>
          <span class="date">{fmtDate(log.data.date)}</span>
          <span class="title">{log.data.title}</span>
          <span class="type">{type}</span>
        </a>
      );
    })}
  </div>
</section>
