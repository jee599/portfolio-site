---
import { getCollection } from 'astro:content';

const logs = (await getCollection('build-logs'))
  .filter((p) => p.data.lang === 'ko')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 7);

const fmtDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${dd}`;
};
---
<section id="logs" class="sec">
  <div class="sec-head">
    <div class="lead">
      <div class="sec-kicker">
        <span class="n">04</span>
        <span class="sep">/</span>
        <span>build logs</span>
      </div>
      <h2 class="sec-h" data-ko="매일 짠 기록" data-en="Shipped daily">
        매일 짠 기록
      </h2>
      <p class="sec-desc" data-ko="이력서 한 줄이 아니라 쌓이는 커밋. 한국어, 영어 빌드 로그로 그날 푼 문제와 막혔던 자리를 같이 남긴다." data-en="Not a resume line — a stack of commits. Korean and English build logs keep both what got solved and what stayed stuck that day.">
        이력서 한 줄이 아니라 쌓이는 커밋. 한국어, 영어 빌드 로그로 그날 푼 문제와 막혔던 자리를 같이 남긴다.
      </p>
    </div>
    <a class="sec-link" href="/posts" data-ko="전체 빌드 로그 →" data-en="all logs →">전체 빌드 로그 →</a>
  </div>

  <div class="logs-wrap">
    {logs.map((log) => {
      const type = log.data.tags?.[0] ?? 'build';
      return (
        <a class="log" href={`/posts/${log.slug}`}>
          <span class="date">{fmtDate(log.data.date)}</span>
          <span class="title">{log.data.title}</span>
          <span class="type">{type}</span>
        </a>
      );
    })}
  </div>
</section>
