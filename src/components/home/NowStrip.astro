---
import { NOW_ITEMS } from '../../data/home';

const items = NOW_ITEMS.slice(0, 4);
---
<section class="status" id="now">
  <div class="status-inner">
    <div class="status-label">
      <span class="pulse"></span>
      <span data-ko="지금" data-en="Now">지금</span>
    </div>
    <div class="status-stream">
      {items.map((it) => (
        <span class="item">
          <span class="tag">{it.tag} ·</span>
          <span>{it.txt}</span>
        </span>
      ))}
    </div>
    <div class="status-meta">
      <span data-now-clock>--:--</span>
      <span data-ko=" KST · git 기준" data-en=" KST · from git"> KST · git 기준</span>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var nodes = document.querySelectorAll('[data-now-clock]');
    if (!nodes.length) return;
    function tick() {
      var now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Seoul' }));
      var hh = String(now.getHours()).padStart(2, '0');
      var mm = String(now.getMinutes()).padStart(2, '0');
      var ss = String(now.getSeconds()).padStart(2, '0');
      var txt = hh + ':' + mm + ':' + ss;
      nodes.forEach(function (n) { n.textContent = txt; });
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
