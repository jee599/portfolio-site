---
const links = [
  {
    kind: 'dev.to',
    name: 'DEV.to',
    handle: '@jee599',
    desc: '영문 기술 포스트.',
    href: 'https://dev.to/jee599',
    external: true,
  },
  {
    kind: 'spoonai',
    name: 'SpoonAI',
    handle: 'spoonai.me',
    desc: 'AI 뉴스 큐레이션.',
    href: 'https://spoonai.me',
    external: true,
  },
  {
    kind: 'feed',
    name: 'RSS',
    handle: '/rss.xml',
    desc: '빌드 로그와 AI 뉴스 피드.',
    href: '/rss.xml',
    external: false,
  },
];
---
<section id="writing" class="sec">
  <div class="sec-head">
    <div class="lead">
      <div class="sec-kicker">
        <span class="n">04</span>
        <span class="sep">/</span>
        <span>writing</span>
      </div>
      <h2 class="sec-h" data-ko="다른 곳에도 쓴다" data-en="Also writes here">
        다른 곳에도 쓴다
      </h2>
      <p class="sec-desc" data-ko="플랫폼마다 톤이 다르다. 핵심만 남긴 포인터." data-en="Tone varies by platform. Pointers only.">
        플랫폼마다 톤이 다르다. 핵심만 남긴 포인터.
      </p>
    </div>
  </div>

  <div class="writing-wrap">
    <div class="writing">
      {links.map((l) => (
        <a
          class="writing-link"
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noreferrer' : undefined}
        >
          <span class="wl-kind">{l.kind}</span>
          <span class="wl-name">
            {l.name}
            <span class="arr">→</span>
          </span>
          <span class="wl-desc">{l.handle} · {l.desc}</span>
        </a>
      ))}
    </div>
  </div>
</section>
